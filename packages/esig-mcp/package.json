{
  "name": "@e-sig/mcp",
  "version": "0.3.0",
  "description": "MCP (Model Context Protocol) server for agent-driven e-signature workflows over @e-sig/core — agents prepare and track envelopes; cryptographic control of signing stays with humans by default (mode H, docs/architecture/esig-mcp.md).",
  "mcpName": "io.github.vmvtech/esig-mcp",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "esig-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "assets/",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "e-signature",
    "esignature",
    "pdf",
    "pades",
    "post-quantum",
    "uuaid",
    "iaaso",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vmvtech/esig-suite.git",
    "directory": "packages/esig-mcp"
  },
  "homepage": "https://github.com/vmvtech/esig-suite/tree/main/packages/esig-mcp#readme",
  "dependencies": {
    "@e-sig/core": "^0.8.0",
    "@e-sig/uaid-exch": "^0.1.0-preview.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
